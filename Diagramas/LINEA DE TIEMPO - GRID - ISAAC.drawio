    <mxGraphModel dx="1935" dy="1063" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2336" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="vccuy-LklcKfFT2Vh3tB-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;strong&gt;1950-1980: orígenes en el diseño gráfico.&lt;/strong&gt; El Estilo Tipográfico Internacional (Suizo) popularizó las retículas modulares en impresos. En 1981, Josef Müller-Brockmann publicó &lt;em&gt;Grid Systems in Graphic Design&lt;/em&gt;." vertex="1">
          <mxGeometry height="160" width="180" x="80" y="90" as="geometry" />
        </mxCell>
        <mxCell id="vccuy-LklcKfFT2Vh3tB-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Finales de los 90: diseño con tablas.&lt;/strong&gt; CSS1 (1996) ya existía, pero se maquetaba con &lt;code dir=&quot;ltr&quot;&gt;&amp;lt;table&amp;gt;&lt;/code&gt; y GIFs espaciadores." vertex="1">
          <mxGeometry height="100" width="180" x="160" y="420" as="geometry" />
        </mxCell>
        <mxCell id="vccuy-LklcKfFT2Vh3tB-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;strong&gt;2004-2006: layouts con &lt;code dir=&quot;ltr&quot;&gt;float&lt;/code&gt;.&lt;/strong&gt; Aparecen técnicas como &lt;em&gt;Faux Columns&lt;/em&gt; (Dan Cederholm, 2004) y &lt;em&gt;Holy Grail&lt;/em&gt; (A List Apart, 2006). En 2006 sale YUI Grids de Yahoo!." vertex="1">
          <mxGeometry height="160" width="180" x="490" y="80" as="geometry" />
        </mxCell>
        <mxCell id="vccuy-LklcKfFT2Vh3tB-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;strong&gt;2007: Blueprint CSS.&lt;/strong&gt; Es uno de los primeros frameworks de grilla, con 24 columnas." vertex="1">
          <mxGeometry height="100" width="180" x="510" y="390" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
